{
  "type": "SIMPLE",

  "max_iterations": 100,

  "velocity_relaxation": 0.7,
  "pressure_relaxation": 0.3,

  "velocity_tolerance": 1e-8,
  "pressure_tolerance": 1e-8,
  "continuity_tolerance": 1e-8,

  "momentum_linear_solver": {
    "type": "BiCGSTAB",
    "absolute_tolerance": 1e-10,
    "relative_tolerance": 1e-8,
    "max_iterations": 500
  },

  "pressure_linear_solver": {
    "type": "BiCGSTAB",
    "absolute_tolerance": 1e-10,
    "relative_tolerance": 1e-8,
    "max_iterations": 2000
  }
}
