{
  "type": "SIMPLE",

  "max_iterations": 50000,

  "velocity_relaxation": 0.7,
  "pressure_relaxation": 0.3,

  "velocity_tolerance": 1e-7,
  "pressure_tolerance": 1e-7,
  "continuity_tolerance": 1e-7,

  "convection_scheme": "quick",
  "face_flux": "rhie_chow",

  "momentum_linear_solver": {
    "type": "BiCGSTAB",
    "absolute_tolerance": 1e-13,
    "relative_tolerance": 1e-6,
    "max_iterations": 1000
  },

  "pressure_linear_solver": {
    "type": "BiCGSTAB",
    "absolute_tolerance": 1e-13,
    "relative_tolerance": 1e-4,
    "max_iterations": 5000
  }
}
