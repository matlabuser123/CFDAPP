  "non_orthogonal_corrections": 1,
  "momentum_linear_solver": {
    "type": "BiCGSTAB",
    "absolute_tolerance": 1e-10,
    "relative_tolerance": 1e-08,
    "max_iterations": 500
  },
  "pressure_linear_solver": {
    "type": "CG",
    "absolute_tolerance": 1e-10,
    "relative_tolerance": 1e-08,
    "max_iterations": 5000
  }
}
