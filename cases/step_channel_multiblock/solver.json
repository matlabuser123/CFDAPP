{
  "type": "SIMPLE",
  "max_iterations": 8000,
  "velocity_relaxation": 0.7,
  "pressure_relaxation": 0.3,
  "velocity_tolerance": 2e-05,
  "pressure_tolerance": 0.0005,
  "continuity_tolerance": 1e-06,
  "convection_scheme": "linear_upwind",
