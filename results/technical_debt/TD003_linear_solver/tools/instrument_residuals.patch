+struct Stats {
+  long long solves = 0;
+  double maxRatio = 0.0;
+  double sumRatio = 0.0;
+  double minRhs = 1e300;
+  double maxRhs = 0.0;
+  long long byConverged = 0;
+  long long byFallback = 0;
+  long long notAcceptable = 0;
+  double maxSumIter = 0.0;
+  double maxSumExact = 0.0;
+  double maxSolveDiff = 0.0;
+  double maxSpeciesDiff = 0.0;
+  bool sawNonTridiagonal = false;
+  long long decompCalls = 0;
+  std::vector<double> aW, aP, aE;
+  bool haveBands = false;
+  // --- closure test: does sum_i b_i equal A*1 ?
+  double maxBandDiff = 0.0;        // max |A_species_i - A_species_0| over all bands
+  double maxClosureAbs = 0.0;      // max_c |sum_i b_i - (A*1)_c|
+  double maxClosureFirst = 0.0;    // the same, restricted to cell 0
