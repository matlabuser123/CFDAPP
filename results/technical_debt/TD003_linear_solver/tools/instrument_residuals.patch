+  long long decompCalls = 0;
+  std::vector<double> aW, aP, aE;
+  bool haveBands = false;
+};
+inline Stats stats;
+
+inline bool extractBands(const cfd::algebra::SparseMatrix& m, std::vector<double>& aW,
+                         std::vector<double>& aP, std::vector<double>& aE) {
+  const cfd::Index n = m.rows();
+  aW.assign(static_cast<std::size_t>(n), 0.0);
+  aP.assign(static_cast<std::size_t>(n), 0.0);
+  aE.assign(static_cast<std::size_t>(n), 0.0);
+  const cfd::Index* off = m.rowOffsetsData();
+  const cfd::Index* col = m.columnIndicesData();
+  const double* val = m.valuesData();
+  bool tri = true;
+  for (cfd::Index r = 0; r < n; ++r) {
+    for (cfd::Index k = off[r]; k < off[r + 1]; ++k) {
+      const cfd::Index c = col[k];
+      if (c == r - 1) {
+        aW[static_cast<std::size_t>(r)] = val[k];
+      } else if (c == r) {
+        aP[static_cast<std::size_t>(r)] = val[k];
+      } else if (c == r + 1) {
+        aE[static_cast<std::size_t>(r)] = val[k];
+      } else if (val[k] != 0.0) {
+        tri = false;
+      }
+    }
+  }
+  return tri;
+}
+
+inline std::vector<double> thomas(const std::vector<double>& aW, const std::vector<double>& aP,
+                                  const std::vector<double>& aE, const std::vector<double>& b) {
+  const std::size_t n = aP.size();
+  std::vector<double> c(n, 0.0), d(n, 0.0), x(n, 0.0);
+  c[0] = aE[0] / aP[0];
+  d[0] = b[0] / aP[0];
+  for (std::size_t i = 1; i < n; ++i) {
+    const double mm = aP[i] - aW[i] * c[i - 1];
+    c[i] = aE[i] / mm;
+    d[i] = (b[i] - aW[i] * d[i - 1]) / mm;
+  }
+  x[n - 1] = d[n - 1];
+  for (std::size_t i = n - 1; i-- > 0;) {
+    x[i] = d[i] - c[i] * x[i + 1];
+  }
+  return x;
+}
+
+inline double normAinvInf() {
+  if (!stats.haveBands) return 0.0;
+  const std::size_t n = stats.aP.size();
+  std::vector<double> rowSum(n, 0.0);
+  for (std::size_t j = 0; j < n; ++j) {
+    std::vector<double> e(n, 0.0);
+    e[j] = 1.0;
+    const std::vector<double> colv = thomas(stats.aW, stats.aP, stats.aE, e);
+    for (std::size_t i = 0; i < n; ++i) rowSum[i] += std::abs(colv[i]);
+  }
+  double m = 0.0;
+  for (std::size_t i = 0; i < n; ++i) m = std::max(m, rowSum[i]);
+  return m;
+}
+
+inline void report() {
+  std::printf("\n========== TD-003 PER-SOLVE INSTRUMENTATION ==========\n");
+  std::printf("solves                      %lld\n", stats.solves);
+  std::printf("  accepted via converged()  %lld\n", stats.byConverged);
+  std::printf("  accepted via residual     %lld\n", stats.byFallback);
+  std::printf("  NOT acceptable            %lld\n", stats.notAcceptable);
+  std::printf("relative residual ||r||/||b||\n");
+  std::printf("  max                       %.6e\n", stats.maxRatio);
+  std::printf("  mean                      %.6e\n",
+              stats.solves ? stats.sumRatio / static_cast<double>(stats.solves) : 0.0);
+  std::printf("||b||_2   min %.6e   max %.6e\n", stats.minRhs, stats.maxRhs);
+  std::printf("\n--- THE DECOMPOSITION (transport steps measured: %lld)\n", stats.decompCalls);
+  std::printf("  max_c |sum_i y_iterative - 1|     %.6e   <- what the gate measures\n",
+              stats.maxSumIter);
+  std::printf("  max_c |sum_i y_EXACT - 1|         %.6e   <- the RHS's own inconsistency\n",
+              stats.maxSumExact);
+  std::printf("  max_c |sum_i (y_iter - y_exact)|  %.6e   <- the SOLVE's contribution\n",
+              stats.maxSolveDiff);
+  std::printf("  max |y_iter - y_exact| per species/cell  %.6e\n", stats.maxSpeciesDiff);
+  std::printf("  tridiagonal everywhere: %s\n",
+              stats.sawNonTridiagonal ? "NO -- Thomas INVALID" : "yes");
+  std::printf("  ||A^-1||_inf of the LAST assembled matrix  %.6f\n", normAinvInf());
+  std::printf("=====================================================\n");
+}
+
