+inline bool extractBands(const cfd::algebra::SparseMatrix& m, std::vector<double>& aW,
+                         std::vector<double>& aP, std::vector<double>& aE) {
+  const cfd::Index n = m.rows();
+  aW.assign(static_cast<std::size_t>(n), 0.0);
+  aP.assign(static_cast<std::size_t>(n), 0.0);
+  aE.assign(static_cast<std::size_t>(n), 0.0);
+  const cfd::Index* off = m.rowOffsetsData();
+  const cfd::Index* col = m.columnIndicesData();
+  const double* val = m.valuesData();
+  bool tri = true;
+  for (cfd::Index r = 0; r < n; ++r) {
+    for (cfd::Index k = off[r]; k < off[r + 1]; ++k) {
+      const cfd::Index c = col[k];
+      if (c == r - 1) {
+        aW[static_cast<std::size_t>(r)] = val[k];
+      } else if (c == r) {
+        aP[static_cast<std::size_t>(r)] = val[k];
+      } else if (c == r + 1) {
+        aE[static_cast<std::size_t>(r)] = val[k];
+      } else if (val[k] != 0.0) {
+        tri = false;
+      }
+    }
+  }
+  return tri;
+}
+
+inline std::vector<double> thomas(const std::vector<double>& aW, const std::vector<double>& aP,
+                                  const std::vector<double>& aE, const std::vector<double>& b) {
+  const std::size_t n = aP.size();
+  std::vector<double> c(n, 0.0), d(n, 0.0), x(n, 0.0);
+  c[0] = aE[0] / aP[0];
+  d[0] = b[0] / aP[0];
+  for (std::size_t i = 1; i < n; ++i) {
+    const double mm = aP[i] - aW[i] * c[i - 1];
+    c[i] = aE[i] / mm;
+    d[i] = (b[i] - aW[i] * d[i - 1]) / mm;
+  }
+  x[n - 1] = d[n - 1];
+  for (std::size_t i = n - 1; i-- > 0;) {
+    x[i] = d[i] - c[i] * x[i + 1];
+  }
+  return x;
+}
+
+// max_c |sum_i Y_i[c] - 1| for a raw field set. Read-only: no solve, no tolerance.
+inline double sumYDeviation(const std::vector<cfd::fields::ScalarField>& comp, cfd::Index ns,
+                            cfd::Index nc) {
+  double m = 0.0;
+  for (cfd::Index c = 0; c < nc; ++c) {
+    double s = 0.0;
+    for (cfd::Index i = 0; i < ns; ++i) s += comp[static_cast<std::size_t>(i)][c];
+    m = std::max(m, std::abs(s - 1.0));
+  }
+  return m;
+}
+
+// rho(M) for M = A^-1 diag(d), by power iteration. One Thomas solve per iteration, so this
+// is exact arithmetic on the assembled operator -- no fitting, no reference to the observed
+// deviation. Returns -1 if it does not settle.
+inline double spectralRadiusOf(const std::vector<double>& aW, const std::vector<double>& aP,
+                               const std::vector<double>& aE, const std::vector<double>& diag,
+                               long long* itersOut) {
+  const std::size_t n = aP.size();
+  if (n == 0) return -1.0;
+  std::vector<double> v(n, 0.0);
+  for (std::size_t i = 0; i < n; ++i) v[i] = 1.0 + 0.01 * static_cast<double>(i % 7);
+  double lam = 0.0;
+  double lamPrev = -1.0;
+  long long it = 0;
+  for (; it < 500; ++it) {
+    std::vector<double> w(n, 0.0);
+    for (std::size_t i = 0; i < n; ++i) w[i] = diag[i] * v[i];
+    const std::vector<double> z = thomas(aW, aP, aE, w);
+    double nz = 0.0;
+    for (std::size_t i = 0; i < n; ++i) nz = std::max(nz, std::abs(z[i]));
+    if (!(nz > 0.0) || !std::isfinite(nz)) return -1.0;
+    lam = nz;  // v is normalised to max-norm 1 below, so ||z||_inf IS the Rayleigh estimate
+    for (std::size_t i = 0; i < n; ++i) v[i] = z[i] / nz;
+    if (it > 10 && std::abs(lam - lamPrev) <= 1e-12 * std::abs(lam)) {
+      ++it;
+      break;
+    }
+    lamPrev = lam;
+  }
+  if (itersOut != nullptr) *itersOut = it;
+  return lam;
+}
+
+inline double normAInf(const std::vector<double>& aW, const std::vector<double>& aP,
+                       const std::vector<double>& aE) {
+  double m = 0.0;
+  for (std::size_t r = 0; r < aP.size(); ++r) {
+    m = std::max(m, std::abs(aW[r]) + std::abs(aP[r]) + std::abs(aE[r]));
+  }
+  return m;
+}
+
+// ||A^-1||_inf for an ARBITRARY band triple, not just the stored one.
+inline double normAinvInfOf(const std::vector<double>& aW, const std::vector<double>& aP,
+                            const std::vector<double>& aE) {
+  const std::size_t n = aP.size();
+  std::vector<double> rowSum(n, 0.0);
+  for (std::size_t j = 0; j < n; ++j) {
+    std::vector<double> e(n, 0.0);
+    e[j] = 1.0;
+    const std::vector<double> colv = thomas(aW, aP, aE, e);
+    for (std::size_t i2 = 0; i2 < n; ++i2) rowSum[i2] += std::abs(colv[i2]);
+  }
+  double m = 0.0;
+  for (std::size_t i2 = 0; i2 < n; ++i2) m = std::max(m, rowSum[i2]);
+  return m;
+}
+
+inline double normAinvInf() {
+  if (!stats.haveBands) return 0.0;
+  const std::size_t n = stats.aP.size();
+  std::vector<double> rowSum(n, 0.0);
+  for (std::size_t j = 0; j < n; ++j) {
+    std::vector<double> e(n, 0.0);
+    e[j] = 1.0;
+    const std::vector<double> colv = thomas(stats.aW, stats.aP, stats.aE, e);
+    for (std::size_t i = 0; i < n; ++i) rowSum[i] += std::abs(colv[i]);
+  }
+  double m = 0.0;
+  for (std::size_t i = 0; i < n; ++i) m = std::max(m, rowSum[i]);
+  return m;
+}
