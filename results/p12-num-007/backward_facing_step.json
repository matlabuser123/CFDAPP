    "expansion_ratio": 2.0,
    "mean_inlet_velocity": 1.0,
    "step_height": 0.5
  },
  "configuration": {
    "algorithm": "SIMPLE, QUICK convection, alpha 0.7/0.3, outer tolerances 1e-6, BiCGSTAB (pressure Jacobi 1e-12/1e-6, momentum 1e-12/1e-8), P12-NUM-004 fallback",
    "geometry": "fluid domain [0, L] x [0, H] downstream of the step, uniform Cartesian cells; the left boundary split into a no-slip step face (y < h) and per-face inlet patches (y > h)",
    "inflow": "u = 24 (y - h)(H - y) (mean 1, max 1.5) as exact face averages; v = 0",
    "outflow": "zero-gradient velocity, p = 0",
    "reattachment": "downstream-most negative -> positive zero crossing of the bottom-wall shear mu u_P/(dy/2), linear interpolation between wall-adjacent cell centres",
    "provenance": "20/30/40 cells/H and Re = 100: BackwardFacingStep.DISABLED_ReattachmentLength (Release). 50 cells/H: standalone driver linking the unchanged Release object of BackwardFacingStepCase.cpp, step::runStep({800, 50, 15}) -- identical case, settings and extraction"
  },
