// P12-NUM-007 follow-up: the Gartling Re = 800 backward-facing step at 50
// cells per H with EXACTLY the existing implementation -- this driver links
// the unchanged Release object of tests/integration/backward_facing_step/
// BackwardFacingStepCase.cpp and calls step::runStep({800, 50, 15}) (same
// Re, geometry, inlet, L = 15H, BCs, QUICK, SIMPLE settings, tolerances and
// extraction as BackwardFacingStep.DISABLED_ReattachmentLength). No
// repository source is changed.
//
//   bfs50 run <single-run.json>
//       solve 50 cells/H, write a single-run ValidationReport.
//   bfs50 combine <existing report.json> <single-run.json> <out stem>
//       rebuild the recorded 20/30/40 (+ Re = 100) runs from the existing
//       report, insert the 50 cells/H run, re-analyse grid convergence with
//       the NUM-005 library on (20,30,40) and (30,40,50), apply the same gate
//       rule as the test (Richardson value if the finest triplet is
//       asymptotic, else the finest-grid value) on the finest triplet, and
//       write <out stem>.json / .md.
#include <cmath>
#include <cstdio>
#include <fstream>
#include <nlohmann/json.hpp>
#include <string>
#include <vector>

#include "BackwardFacingStepCase.hpp"
#include "cfd/validation/GridConvergenceStudy.hpp"
#include "cfd/validation/ProductionValidation.hpp"

using cfd::Real;
namespace v = cfd::validation;
using Json = nlohmann::json;

namespace {

v::ValidationRun runFromJson(const Json& r, const Json& doc) {
  v::ValidationRun run;
  run.caseName = r["case"].get<std::string>();
  if (!r["reynolds"].is_null()) run.reynolds = r["reynolds"].get<Real>();
  run.scheme = r["scheme"].get<std::string>();
  auto& l = run.level;
  l.name = r["mesh"].get<std::string>();
  l.nx = r["nx"].get<cfd::Index>();
  l.ny = r["ny"].get<cfd::Index>();
  l.cells = r["cells"].get<cfd::Index>();
  l.h = r["h"].get<Real>();
  l.solverStatus = r["solver_status"].get<std::string>();
  l.accepted = r["accepted"].get<bool>();
  l.rejectionReason = r["rejection_reason"].get<std::string>();
  l.iterations = r["iterations"].get<cfd::Index>();
  if (!r["mass_imbalance"].is_null()) l.massImbalance = r["mass_imbalance"].get<Real>();
  for (const auto& [name, e] : r["errors"].items()) {
    v::ErrorNorms n;
    n.l1 = e["l1"].get<Real>();
    n.l2 = e["l2"].get<Real>();
    n.linf = e["linf"].get<Real>();
    n.cells = e["samples"].get<cfd::Index>();
    n.volume = e["weight"].get<Real>();
    l.errors.emplace_back(name, n);
  }
  for (const auto& [name, value] : r["diagnostics"].items()) {
    if (!value.is_null()) l.diagnostics.emplace_back(name, value.get<Real>());
  }
  for (const auto& c : r["checks"]) {
    run.checks.push_back({c["name"].get<std::string>(), c["passed"].get<bool>(),
                          c["detail"].get<std::string>()});
  }
  for (const auto& t : doc["runtime"]["runs"]) {
    if (t["id"] == r["id"]) l.runtimeSeconds = t["seconds"].get<double>();
  }
  return run;
}

Json load(const std::string& path) {
  std::ifstream in(path);
  return Json::parse(in);
}

void print(const v::ValidationRun& run) {
  std::printf("%s: %s, accepted %d, %llu it, %.1f s, mass imbalance %.3g\n", run.id().c_str(),
              run.level.solverStatus.c_str(), run.level.accepted ? 1 : 0,
              static_cast<unsigned long long>(run.level.iterations), run.level.runtimeSeconds,
              run.level.massImbalance.value_or(std::nan("")));
  for (const auto& [k, value] : run.level.diagnostics) std::printf("  %s = %.10g\n", k.c_str(), value);
  for (const auto& c : run.checks) std::printf("  [%s] %s: %s\n", c.passed ? "x" : " ", c.name.c_str(), c.detail.c_str());
}

}  // namespace

int main(int argc, char** argv) {
  if (argc >= 3 && std::string(argv[1]) == "run") {
    // Optional argv[3]: cells per H (default 50; 20 = reproduction check).
    const cfd::Index perH = argc >= 4 ? static_cast<cfd::Index>(std::stoul(argv[3])) : 50;
    const v::ValidationRun run = v::step::runStep({800.0, perH, 15.0});
    print(run);
    v::ValidationReport single;
    single.name = "backward_facing_step_re800_50";
    single.description = "Gartling backward-facing step, Re = 800, 50 cells per H (750x50), L = 15H, QUICK";
    single.reference = "see backward_facing_step.json";
    single.runs.push_back(run);
    v::writeValidationReport(argv[2], single);
    return run.passed() ? 0 : 1;
  }
  if (argc >= 5 && std::string(argv[1]) == "combine") {
    const Json old = load(argv[2]);
    const Json add = load(argv[3]);
    v::ValidationReport report;
    report.name = old["study"].get<std::string>();
    report.description =
        "Laminar backward-facing step (Gartling 1990, ER = 2): Re = 800 on 20/30/40/50 cells per H, "
        "L = 15H, QUICK; Re = 100 on 20 cells per H";
    report.reference = old["reference"].get<std::string>();
    for (const auto& [k, value] : old["coefficients"].items()) report.coefficients.emplace_back(k, value.get<Real>());
    for (const auto& [k, value] : old["configuration"].items()) report.configuration.emplace_back(k, value.get<std::string>());
    report.configuration.emplace_back(
        "provenance",
        "20/30/40 cells/H and Re = 100: BackwardFacingStep.DISABLED_ReattachmentLength (Release). 50 "
        "cells/H: standalone driver linking the unchanged Release object of BackwardFacingStepCase.cpp, "
        "step::runStep({800, 50, 15}) -- identical case, settings and extraction");
    std::vector<v::ValidationRun> oldRuns;
    for (const auto& r : old["runs"]) oldRuns.push_back(runFromJson(r, old));
    const v::ValidationRun newRun = runFromJson(add["runs"][0], add);
    // Order: Re 800 20, 30, 40, 50, then Re 100.
    report.runs = {oldRuns[0], oldRuns[1], oldRuns[2], newRun, oldRuns[3]};
    for (const auto& r : report.runs) print(r);

    v::QuantitySpec reattachment;
    reattachment.name = "reattachment_length_over_h";
    reattachment.description = "x_r/h, lower-wall primary eddy (published range [11.48, 12.20])";
    reattachment.reference = 0.5 * (11.48 + 12.20);
    reattachment.referenceKind = "benchmark";
    reattachment.options.formalOrder = 2.0;
    reattachment.options.absoluteNoise = 1e-4;
    reattachment.options.gridIndependenceThreshold = 0.01;
    v::QuantitySpec bubble = reattachment;
    bubble.name = "upper_bubble_length_over_h";
    bubble.description = "(x_rs - x_s)/h, upper-wall bubble (published range [10.60, 11.52])";
    bubble.reference = 0.5 * (10.60 + 11.52);
    // Components of the bubble length: reported (no published per-point range used).
    v::QuantitySpec separation = reattachment;
    separation.name = "upper_separation_over_h";
    separation.description = "x_s/h, upper-wall separation (reported)";
    separation.reference.reset();
    separation.referenceKind = "";
    v::QuantitySpec upperReattachment = separation;
    upperReattachment.name = "upper_reattachment_over_h";
    upperReattachment.description = "x_rs/h, upper-wall reattachment (reported)";
    const std::vector<std::string> names = {"reattachment_length_over_h", "upper_bubble_length_over_h",
                                            "upper_separation_over_h", "upper_reattachment_over_h"};
    const std::vector<v::QuantitySpec> quantities = {reattachment, bubble, separation, upperReattachment};
    const auto study = [&](int a, int b, int c, const char* name, const char* description) {
      std::vector<v::GridStudyEntry> entries;
      for (const int k : {a, b, c}) entries.push_back(v::toGridStudyEntry(report.runs[static_cast<std::size_t>(k)], 15.0, 1.0, names));
      return v::analyzeGridStudy(name, description, std::move(entries), quantities);
    };
    report.gridConvergence.push_back(study(0, 1, 2, "backward_facing_step_re800_20_30_40", "Re = 800, QUICK, 20/30/40 cells per H"));
    report.gridConvergence.push_back(study(1, 2, 3, "backward_facing_step_re800_30_40_50", "Re = 800, QUICK, 30/40/50 cells per H"));

    // Same gate rule as the test, on the finest triplet (30, 40, 50).
    const auto& finest = report.gridConvergence[1];
    for (const auto& q : finest.quantities) {
      Real lo = 0.0, hi = 0.0;
      if (q.spec.name == "reattachment_length_over_h") {
        lo = 11.48;
        hi = 12.20;
      } else if (q.spec.name == "upper_bubble_length_over_h") {
        lo = 10.60;
        hi = 11.52;
      } else {
        continue;
      }
      const auto& a = q.analysis;
      const bool useExtrapolated = a.extrapolated21.has_value() && a.status == v::GridConvergenceStatus::Asymptotic;
      const std::optional<Real> value = useExtrapolated ? a.extrapolated21 : q.values[2];
      const bool inRange = value.has_value() && *value >= lo && *value <= hi;
      char detail[256];
      std::snprintf(detail, sizeof(detail), "%s %.4f vs published [%.2f, %.2f] (30/40/50 status %s)",
                    useExtrapolated ? "Richardson-extrapolated" : "finest-grid (50 cells/H)",
                    value.value_or(std::nan("")), lo, hi,
                    std::string(v::gridConvergenceStatusName(a.status)).c_str());
      report.gates.push_back({q.spec.name + "_within_published_range", inRange, detail});
    }
    for (const auto& text : old["limitations"]) report.limitations.push_back(text.get<std::string>());
    for (auto& text : report.limitations) {
      if (text.rfind("Uniform Cartesian grids only", 0) == 0) {
        text = "Uniform Cartesian grids only (no clustering at the step corner or walls); the finest grid "
               "here has 50 cells per H.";
      }
    }
    v::writeValidationReport(std::string(argv[4]) + ".json", report);
    std::ofstream md(std::string(argv[4]) + ".md", std::ios::binary);
    md << v::validationReportMarkdown(report);
    std::printf("\n%s", v::validationReportMarkdown(report).c_str());
    return report.passed() ? 0 : 1;
  }
  std::fprintf(stderr, "usage: bfs50 run <out.json> | bfs50 combine <old.json> <single.json> <out stem>\n");
  return 2;
}
