# Build outputs -- regenerated by cmake --preset {debug,release}; never
# committed (TODO.md "P1 -- Quality Gate" section 26).
build/
out/

# Local CMake preset overrides (personal, not shared).
CMakeUserPresets.json

# Editor/IDE local state.
.vs/
.vscode/*
!.vscode/extensions.json
*.user
.idea/

# Stray MSVC/GCC/Clang diagnostic artifacts -- ad hoc standalone probes
# compiled outside the build system (e.g. an isolated microbenchmark, see
# results/performance/assembly/'s own header comment on how those are
# produced) leave these at the repo root; never intended to be committed.
*.obj
*.pdb
*.ilk
*.o
*.exe
*.dll

# In case anyone ever configures in-source by mistake.
CMakeCache.txt
CMakeFiles/

# Ad hoc log output from local tooling runs (e.g. this project's own
# scripts/windows-release/ recipe) -- results/release/<version>/ holds the
# real, curated release-evidence logs that *are* meant to be committed;
# the negation below actually carves that out (a bare "*.log" alone
# still matched them despite this same comment already saying otherwise).
*.log
!results/release/**/*.log
# Curated phase-evidence logs (focused/explicit test runs) cited by
# results/p12-*/summary.md are evidence, not ad hoc tool output.
!results/p12-*/**/*.log
# Same for phases whose name is not "p12-*" (CUDA-QUAL-001 was the first;
# its logs carry the freeze hashes, the failed-gate runs and the
# two-toolchain attribution its summary.md cites).
!results/cuda-qual-001/**/*.log
!results/gpu-pcorr-001/**/*.log
!results/ci-perf-001/**/*.log

# Python -----------------------------------------------------------------
python/__pycache__/
python/**/__pycache__/
python/.pytest_cache/
python/*.egg-info/
python/.venv/
python/.ruff_cache/
**/__pycache__/
*.pyc

# OS cruft.
Thumbs.db
.DS_Store

# Stray CMake Tools / clang-tidy scratch output left at the repo root by
# IDE tooling (TODO.md P1 -- Quality Gate section 25-26); not source.
cmake_test_discovery_*.json
tidy_output.txt

# aqtinstall (P5-J Windows packaging) writes its own log to the current
# working directory by default -- never project content.
aqtinstall.log
